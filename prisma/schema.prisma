generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                  Int       @id @default(autoincrement())
  nombre              String
  correo              String    @unique
  password            String
  diasDisponibles     String?
  horariosDisponibles String?
  barriosPreferidos   String?
  historial           Partido[] @relation("UsuarioAPartidos")
  tarjetasInscritas   Tarjeta[] @relation("UsuariosInscriptos")
  imagen              String?
  resenasEscritas     Resena[]  @relation("ResenasEscritas")
  resenasRecibidas    Resena[]  @relation("ResenasRecibidas")
}

model Partido {
  id                 Int       @id @default(autoincrement())
  cancha             String
  lugar              String
  dia                String
  hora               String
  jugadoresFaltantes Int
  latitud            Float?
  longitud           Float?
  posicionFaltante   String?
  fechaHora          DateTime?
  usuario            Usuario   @relation("UsuarioAPartidos", fields: [usuarioId], references: [id])
  usuarioId          Int
  tarjeta            Tarjeta?
  resenas            Resena[]
}

model Tarjeta {
  id        Int        @id @default(autoincrement())
  partido   Partido    @relation(fields: [partidoId], references: [id])
  partidoId Int        @unique
  usuarios  Usuario[]  @relation("UsuariosInscriptos")
  imagen    String?
}

model Resena {
  id           Int      @id @default(autoincrement())
  calificacion Int
  comentario   String?
  autor        Usuario  @relation("ResenasEscritas", fields: [autorId], references: [id])
  autorId      Int
  receptor     Usuario  @relation("ResenasRecibidas", fields: [receptorId], references: [id])
  receptorId   Int
  partido      Partido  @relation(fields: [partidoId], references: [id])
  partidoId    Int
  createdAt    DateTime @default(now())

  @@unique([autorId, receptorId, partidoId])
}
